# Example Environment Configuration
# Copy this to .env and fill in actual values

# ============ DATABASE ============
DB_USER=stock_user
DB_PASSWORD=SecurePassword123!
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_db

TS_DB_USER=ts_user
TS_DB_PASSWORD=TSSecurePassword123!
TS_DB_HOST=timescaledb
TS_DB_PORT=5433
TS_DB_NAME=timeseries_db

# ============ MONGODB ============
MONGO_USER=mongo_user
MONGO_PASSWORD=MongoPassword123!
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=stock_db

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ KAFKA ============
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_STOCK_PRICES=stock-prices
KAFKA_TOPIC_NEWS_EVENTS=news-events
KAFKA_TOPIC_RECOMMENDATIONS=recommendations-queue

# ============ EXTERNAL APIs ============
# Stock Data APIs
YFINANCE_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# News & Sentiment APIs
NEWSAPI_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# LLM APIs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============ APPLICATION ============
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ SECURITY ============
JWT_SECRET=YourVerySecureJWTSecretKeyHere
JWT_EXPIRY_HOURS=24
SESSION_TIMEOUT_MINUTES=30

# ============ MCP SERVERS ============
MCP_STOCK_DATA_URL=http://stock-data-server:5001
MCP_SENTIMENT_URL=http://sentiment-server:5002
MCP_PREDICTION_URL=http://prediction-server:5003
MCP_PORTFOLIO_URL=http://portfolio-server:5004
MCP_ALERT_URL=http://alert-server:5006
MCP_TECHNICAL_URL=http://technical-analysis-server:5005
MCP_ORCHESTRATOR_URL=http://ai-orchestrator:5000

MCP_TIMEOUT_MS=5000
MCP_RETRY_COUNT=3
MCP_RETRY_BACKOFF_MS=1000

# ============ MONITORING ============
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=

# ============ MAIL ============
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_FROM=noreply@stockintel.com
MAIL_USERNAME=
MAIL_PASSWORD=

# ============ AWS ============
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=stock-data-lake

# ============ FEATURE FLAGS ============
FEATURE_BACKTESTING_ENABLED=true
FEATURE_CRASH_PREDICTION_ENABLED=false
FEATURE_SENTIMENT_ANALYSIS_ENABLED=true
FEATURE_PORTFOLIO_OPTIMIZATION_ENABLED=true
