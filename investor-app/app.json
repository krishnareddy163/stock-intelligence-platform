{
  "expo": {
    "name": "InvestorIQ",
    "slug": "investor-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#00b386"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.investoriq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00b386"
      },
      "package": "com.investoriq.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "investoriq"
  }
}
