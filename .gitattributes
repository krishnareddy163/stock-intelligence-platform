# Ensure consistent line endings
* text=auto

# Java
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

# Python
*.py text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# JavaScript/Frontend
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
